# Скопируйте в .env и поменяйте значения. Секреты в репозиторий не коммитим.

# --- Django ---
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- PostgreSQL ---
POSTGRES_DB=sabyr
POSTGRES_USER=sabyr
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://sabyr:change-me@db:5432/sabyr

# --- Межбанковский реестр (Hyperledger Fabric) ---
# Общая для консорциума соль: банки должны получать одинаковый хэш одного и того же счёта.
LEDGER_SALT=change-me-consortium-salt
# Адрес сервиса-шлюза (ledger/gateway). Пусто = реестр отключён (API честно вернёт ledger.status=disabled).
LEDGER_GATEWAY_URL=http://ledger-gateway:8090

# --- ИИ-ассистент ---
# own  — своя дообученная модель (ml/llm/serve.py, OpenAI-совместимый эндпоинт)
# api  — внешний LLM API (Anthropic)
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OWN_LLM_URL=http://llm:8001/v1
OWN_LLM_MODEL=sabyr-assistant

# --- Sabyr ---
SABYR_COOLDOWN_MINUTES=15
