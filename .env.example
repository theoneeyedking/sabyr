# Скопируйте в .env и поменяйте значения. Секреты в репозиторий не коммитим.

# --- Django ---
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- PostgreSQL ---
POSTGRES_DB=sabyr
POSTGRES_USER=sabyr
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://sabyr:change-me@db:5432/sabyr

# --- Межбанковский реестр (Hyperledger Fabric) ---
# Общая для консорциума соль: банки должны получать одинаковый хэш одного и того же счёта.
LEDGER_SALT=change-me-consortium-salt
# Адрес сервиса-шлюза (ledger/gateway). Пусто = реестр отключён (API честно вернёт ledger.status=disabled).
LEDGER_GATEWAY_URL=http://ledger-gateway:8090

# --- ИИ-ассистент ---
# anthropic — внешний LLM API (Anthropic Claude), нужен LLM_API_KEY
# own       — своя дообученная модель (ml/llm/serve.py, OpenAI-совместимый эндпоинт; веса пока не обучены)
# Без ключа или при недоступном API ассистент отвечает заранее согласованными текстами (provider=static),
# а причины риска остаются шаблонными — демо не падает.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Пусто = claude-opus-5-5
LLM_MODEL=
# Таймаут одного запроса и число повторов: 6 с × 2 попытки укладываются в таймаут приложения (20 с)
LLM_TIMEOUT_SECONDS=6
LLM_MAX_RETRIES=1
# 1 — LLM переписывает причины риска (с проверкой фактов), 0 — только шаблоны
LLM_REASONS=1
OWN_LLM_URL=http://llm:8001/v1
OWN_LLM_MODEL=sabyr-assistant

# --- Sabyr ---
SABYR_COOLDOWN_MINUTES=15
